{
  "name": "yampi-theme-sync",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Exportação e sincronização local dos arquivos do editor de temas Yampi",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.3",
    "playwright": "1.64.0",
    "sass": "1.105.1",
    "twig": "3.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16"
  }
}
