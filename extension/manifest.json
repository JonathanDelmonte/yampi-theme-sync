{
  "manifest_version": 3,
  "name": "Yampi Theme Sync",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Exporta e compara arquivos do tema Yampi. Envia alterações selecionadas com backup, sem publicar a loja.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Abrir Yampi Theme Sync neste editor"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
